# Copy this file to .env and fill your own key.
# Do not commit .env to Git.

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_PATH=/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

REQUEST_TIMEOUT_SECONDS=15
MAX_HISTORY_MESSAGES=12
MAX_IN_MEMORY_SESSIONS=100
SESSION_TTL_SECONDS=3600
LOG_LEVEL=INFO

# Optional cost estimation, in USD per 1M tokens.
INPUT_TOKEN_PRICE_PER_1M=0
OUTPUT_TOKEN_PRICE_PER_1M=0
TRACE_BUFFER_SIZE=200

